{
  "name": "primal",
  "version": "0.3.0",
  "private": true,
  "description": "THE HERD — an endless runner where your body is the controller. Webcam pose detection turns real movement into game input.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test --experimental-strip-types --import ./test/register.mjs \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
